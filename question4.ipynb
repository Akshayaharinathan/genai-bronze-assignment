import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from mpl_toolkits.mplot3d import Axes3D

# Sample House Dataset
data = {
    'Area': [1000, 1200, 1500, 1800, 2000, 2200, 2500, 2800],
    'Bedrooms': [2, 2, 3, 3, 4, 4, 5, 5],
    'Price': [200000, 240000, 300000, 360000, 400000, 440000, 500000, 560000]
}

df = pd.DataFrame(data)

# Features and Target
X = df[['Area', 'Bedrooms']]
y = df['Price']

# Train Linear Regression Model
model = LinearRegression()
model.fit(X, y)

# Create Mesh Grid for Regression Plane
area_range = np.linspace(df['Area'].min(), df['Area'].max(), 20)
bedroom_range = np.linspace(df['Bedrooms'].min(), df['Bedrooms'].max(), 20)

A, B = np.meshgrid(area_range, bedroom_range)

price_pred = model.predict(
    np.c_[A.ravel(), B.ravel()]
).reshape(A.shape)

# 3D Plot
fig = plt.figure(figsize=(10, 7))
ax = fig.add_subplot(111, projection='3d')

# Actual Data Points
ax.scatter(
    df['Area'],
    df['Bedrooms'],
    df['Price'],
    color='red',
    s=50,
    label='Actual Data'
)

# Regression Plane
ax.plot_surface(
    A,
    B,
    price_pred,
    cmap='viridis',
    alpha=0.7
)

# Labels
ax.set_xlabel('Area (sq ft)')
ax.set_ylabel('Bedrooms')
ax.set_zlabel('House Price')

ax.set_title('3D Regression Model for House Price Prediction')
ax.legend()

plt.show()

# Model Details
print("Intercept:", model.intercept_)
print("Coefficients:", model.coef_)
print("R² Score:", model.score(X, y))
