import matplotlib.pyplot as plt
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense, Input

# Layer sizes
layers = [6, 8, 4, 1]

fig, ax = plt.subplots(figsize=(10, 6))

# Draw neurons
for i, layer_size in enumerate(layers):
    x = i * 2
    y_positions = range(layer_size)

    for y in y_positions:
        circle = plt.Circle((x, y), 0.2, color='skyblue', ec='black')
        ax.add_patch(circle)

# Draw connections
for i in range(len(layers) - 1):
    x1 = i * 2
    x2 = (i + 1) * 2

    for y1 in range(layers[i]):
        for y2 in range(layers[i + 1]):
            ax.plot([x1, x2], [y1, y2], 'gray', linewidth=0.5)

# Labels
ax.text(0, 6.5, "Input Layer\n(6 Features)", ha='center', fontsize=12)
ax.text(2, 8.5, "Hidden Layer 1\n(8 Neurons)", ha='center', fontsize=12)
ax.text(4, 4.5, "Hidden Layer 2\n(4 Neurons)", ha='center', fontsize=12)
ax.text(6, 1.5, "Output Layer\n(Fraud)", ha='center', fontsize=12)

plt.axis('off')
plt.title("Neural Network Architecture for Credit Card Fraud Detection")
plt.show()

model = Sequential([

Input(shape=(6,)),

Dense(8, activation='relu'),

Dense(4, activation='relu'),

Dense(1, activation='sigmoid')

])

model.summary()
